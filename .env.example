# Retell AI API
RETELL_API_KEY=your_retell_api_key_here
RETELL_API_BASE_URL=https://api.retellai.com/v2
RETELL_AGENT_IDS=agent_id_1,agent_id_2,agent_id_3

# Database
DATABASE_URL=postgresql://postgres:root@localhost:5432/digitalytics

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here-min-32-chars

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin seed credentials (used by prisma:seed)
ADMIN_EMAIL=admin@digitalytics.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin

# Application
NODE_ENV=development
LOG_LEVEL=info
SYNC_BATCH_SIZE=1000
