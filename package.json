{
  "name": "digiweb-agents",
  "version": "1.0.0",
  "description": "Retell AI call logs sync to PostgreSQL - Full Stack Dashboard",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:backend": "tsc",
    "sync:initial": "tsx scripts/initial-sync.ts",
    "sync:incremental": "tsx scripts/incremental-sync.ts",
    "sync:detailed": "tsx scripts/detailed-sync.ts",
    "verify": "tsx scripts/verify-data.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "jest --config jest.config.cjs",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"app/**/*.tsx\" \"components/**/*.tsx\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "retell",
    "ai",
    "call-logs",
    "postgresql",
    "prisma",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.1.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.34.3",
    "geist": "^1.7.0",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.7.0",
    "stripe": "^20.4.0",
    "tailwind-merge": "^3.5.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
